{
  "name": "nightshift",
  "version": "0.0.0",
  "private": true,
  "description": "A live screen for your Claude Code agents: what they are doing now and what they did overnight. Runs on your own computer; nothing leaves it.",
  "keywords": [
    "claude-code",
    "agents",
    "agentic-coding",
    "dashboard",
    "cli"
  ],
  "author": "Denis Zontak <denis@zontakllc.com>",
  "license": "MIT",
  "homepage": "https://github.com/Zontak-LLC/nightshift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zontak-LLC/nightshift.git"
  },
  "bugs": {
    "url": "https://github.com/Zontak-LLC/nightshift/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nightshift": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:rules": "node scripts/check-rules.mjs",
    "ci": "npm run check:rules && npm run lint && npm run typecheck && vitest run --coverage",
    "prepublishOnly": "npm run ci && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
