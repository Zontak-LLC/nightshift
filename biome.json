{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": { "includes": ["**", "!dist", "!coverage", "!node_modules"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noConsole": { "level": "error", "options": { "allow": ["error", "info"] } } },
      "style": { "noNonNullAssertion": "error" },
      "complexity": { "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 20 } } },
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" }
    }
  }
}
